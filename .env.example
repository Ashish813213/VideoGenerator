# Server
PORT=3000

# Google Gemini (TTS + scene planning)
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
TTS_TIMEOUT_MS=180000

# Unsplash (primary image source)
# Get from https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Pexels (fallback image source)
# Get from https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Paths
JOBS_DIR=./jobs
OUTPUT_DIR=./output
ASSETS_DIR=./assets
FONT_PATH=C:/Windows/Fonts/arial.ttf

# Limits
MAX_SCRIPT_CHARS=5000
MAX_CONCURRENT_JOBS=2

# TTS — set to true to skip voice synthesis and use a silent audio track
SKIP_TTS=true
# Average narration speed used to estimate duration when SKIP_TTS=true
WORDS_PER_MINUTE=150
